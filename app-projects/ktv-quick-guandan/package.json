{
  "name": "ktv-quick-guandan",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5342",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "audio:edge": "powershell -ExecutionPolicy Bypass -File scripts/generate-edge-voice-assets.ps1",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify": "npm run lint && npm test && npm run build && npm run verify:browser"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "playwright": "^1.54.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6"
  }
}
